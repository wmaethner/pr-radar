{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR Radar",
  "version": "0.4.0",
  "identifier": "com.wmaethner.prradar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PR Radar",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Will Maethner",
    "copyright": "Copyright (c) 2026 Will Maethner",
    "shortDescription": "Shows which GitHub and Azure DevOps PRs need your attention",
    "longDescription": "PR Radar is a desktop app that sorts the open pull requests you authored or are reviewing into what needs your action, what is ready to merge and what is waiting on others. It reads from your GitHub and Azure DevOps repos using your existing gh and az CLI sign-ins.",
    "homepage": "https://github.com/wmaethner/pr-radar"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RUEzRDBCQjI4OTM4NzMKUldSek9JbXlDejNxSjNXclpTQWFsNjZhakxCa3ZtSlZsRGdDQXRGaThBNTFxRDZRWW1GVTdqcjEK",
      "endpoints": [
        "https://github.com/wmaethner/pr-radar/releases/latest/download/latest.json"
      ]
    }
  }
}
