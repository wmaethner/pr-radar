{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pr-radar",
  "version": "0.2.0",
  "identifier": "com.wmaethner.prradar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pr-radar",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RUEzRDBCQjI4OTM4NzMKUldSek9JbXlDejNxSjNXclpTQWFsNjZhakxCa3ZtSlZsRGdDQXRGaThBNTFxRDZRWW1GVTdqcjEK",
      "endpoints": [
        "https://github.com/wmaethner/pr-radar/releases/latest/download/latest.json"
      ]
    }
  }
}
