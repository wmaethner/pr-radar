{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-overlay-icon",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart"
  ]
}
